# Local Ollama (models installed on this machine; no external API is used)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=180

# Gateway Settings
PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=*

# true = an answer slower than the judge's Max Latency counts as a failure and triggers failover
STRICT_LATENCY=false
